# Copy to .env and fill in your keys (never commit .env)

GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
# Detection uses this model first (smaller model improves uptime for continuous runs).
DETECTION_LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODELS=llama-3.1-8b-instant,groq/compound-mini,qwen/qwen3-32b,openai/gpt-oss-20b

# Optional: live IP enrichment (public IPs only)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Optional: GitHub live events backup source
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_RAW_FEED_URL=
GITHUB_RAW_FEED_FORMAT=jsonl

# Neo4j (knowledge graph tab). docker compose sets URI to bolt://neo4j:7687 automatically.
# Local Streamlit (no Docker): use bolt://localhost:7687 and run Neo4j yourself, or: docker compose up neo4j -d
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Default when using `docker compose up`: socgraph-dev (matches compose). Change in production.
NEO4J_PASSWORD=
NEO4J_BROWSER_URL=http://localhost:7474
